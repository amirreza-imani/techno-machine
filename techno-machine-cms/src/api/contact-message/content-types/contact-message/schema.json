{
  "kind": "collectionType",
  "collectionName": "contact_messages",
  "info": {
    "singularName": "contact-message",
    "pluralName": "contact-messages",
    "displayName": "Contact Message"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email"
    },
    "subject": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "text"
    },
    "requestStatus": {
      "type": "enumeration",
      "default": "new",
      "enum": [
        "new",
        "contacted",
        "in-progress",
        "completed",
        "cancelled"
      ]
    }
  }
}
